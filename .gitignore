# OS / file manager noise
.DS_Store
Thumbs.db
.github/instructions/*
# Editor / IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Logs and temporary files
*.log
*.tmp
*.temp

# Python cache (if local scripts are used)
__pycache__/
*.pyc

# Node/package manager outputs (future-proof)
node_modules/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local release/build artifacts
release/
*.zip

# Optional local preview assets (images can be large and temporary)
preview/assets/*
!preview/assets/.gitkeep
